DATABASE_URL=postgresql+psycopg://expense:expense@localhost:5432/expense_claims
SECRET_KEY=change-me
DEMO_PASSWORD=password123
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
STORAGE_BACKEND=local
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=your-private-bucket-name
STORAGE_DIR=../storage
UPLOAD_MAX_SIZE_MB=10
PRESIGNED_URL_EXPIRES=300
PDF_MAX_PAGES=10
PDF_RENDER_DPI=180
PDF_JPEG_QUALITY=80

# --- tiered storage (hot = local or MinIO, cold = S3 archive) -----------------
# Cold tier: paid receipts are archived here with the class below; payment
# never depends on promotion succeeding.
COLD_S3_BUCKET_NAME=
S3_STORAGE_CLASS=STANDARD_IA
PAID_CACHE_DAYS=7
# MinIO as the hot object store (S3 API compatible). Leave MINIO_ENDPOINT set
# to empty to use the local disk for the hot tier.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=receipts-hot

# --- receipt in-memory cache ---------------------------------------------------
RECEIPT_CACHE_TTL_SECONDS=3600
RECEIPT_CACHE_MAX_BYTES=67108864
